# Copiar este archivo como ".env" y completar las claves. Sin .env el sistema corre en modo demo
# (los correos, incluidos los códigos de firma, quedan en la bandeja "Correos (simulados)").
# El archivo .env NO se sube a GitLab.

# Dirección pública del sistema (se usa en los enlaces de los correos)
APP_URL=http://localhost:8000

# Correo con Resend (https://resend.com, 3 000 correos/mes gratis)
RESEND_API_KEY=
MAIL_FROM=Calidad Stracon <calidad@stracon.com>
