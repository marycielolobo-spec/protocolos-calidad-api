# Copiar este archivo como ".env" (en la misma carpeta) y completar. Sin .env el sistema corre en modo demo:
# los correos, incluidos los códigos de firma, quedan en la bandeja "Correos (simulados)".
# El archivo .env NO se sube a GitHub. No compartas su contenido por chat ni correo.

# Dirección del servidor (API)
APP_URL=http://localhost:8000

# Con las pantallas de Lovable (quality-standards-hub), completar con la dirección donde se publiquen:
#   URL_PORTAL=https://<frontend>/revision      (enlace que recibe KP / Hudbay por correo)
#   URL_APP=https://<frontend>                  (enlace "Abrir protocolo" de los correos internos)
#   CORS_ORIGENES=https://<frontend>            (quién puede llamar a la API; "*" = cualquiera, solo demo)

# Correo. Opción A: cuenta corporativa de Microsoft 365 / Outlook (si TI permite "SMTP autenticado"):
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
# Opción B: cuenta de Gmail del sistema (estos son los valores por defecto):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# En Gmail, SMTP_PASSWORD es la "contraseña de aplicación" de 16 letras (NO la contraseña normal).
SMTP_USER=
SMTP_PASSWORD=
# Nombre que verá el destinatario (el correo sale desde SMTP_USER)
MAIL_FROM=Protocolos de Calidad STRACON <>

# (Alternativa) Resend, solo si algún día se verifica un dominio
RESEND_API_KEY=

# Supabase (Project Settings). URL y clave publicable no son secretas; las otras dos SÍ (no compartir).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Botón "Connect" → "Transaction pooler" (puerto 6543), reemplazando [YOUR-PASSWORD] por la contraseña de la base
DATABASE_URL=
